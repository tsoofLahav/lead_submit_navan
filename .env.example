DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
SECRET_KEY=
# SESSION_COOKIE_SECURE=true  # Set for HTTPS outside Render.

# Optional. The non-AI app runs without this key.
OPENAI_API_KEY=
AI_SERVICE_TIER=fast
AI_TIMEOUT_SECONDS=120
AI_RESEARCH_MAX_TOOL_CALLS=5
AI_RESEARCH_SEARCH_CONTEXT_SIZE=low
AI_RESEARCH_MAX_OUTPUT_TOKENS=8000
AI_PREDICTION_MAX_OUTPUT_TOKENS=2000
AI_DECISION_MAX_OUTPUT_TOKENS=2000
AI_EVALUATION_TIMEOUT_SECONDS=240
AI_EVALUATION_MAX_ESTIMATED_USD=4.00
AI_RESEARCH_MODEL=gpt-6.2-astra
AI_RESEARCH_REASONING_EFFORT=medium
AI_PREDICTION_MODEL=gpt-6.2-astra
AI_PREDICTION_REASONING_EFFORT=low
AI_DECISION_MODEL=gpt-6.2-astra
AI_DECISION_REASONING_EFFORT=low
AI_CHAT_MODEL=gpt-6.2-astra
AI_CHAT_REASONING_EFFORT=low
# Per-component overrides also support _SERVICE_TIER and _MAX_OUTPUT_TOKENS.

AI_CHAT_HISTORY_LIMIT=20
AI_CHAT_TOOL_BUDGET=6
AI_CHAT_MAX_ROUNDS=8

# Evaluation observability. Leave the report directory empty to disable reports.
AI_DIAGNOSTICS_LOG_LEVEL=INFO
AI_DIAGNOSTICS_REPORT_DIR=.evaluation-diagnostics
